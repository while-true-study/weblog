{
  "family": "weblog-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::488762301655:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::488762301655:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "weblog",
      "image": "488762301655.dkr.ecr.ap-northeast-2.amazonaws.com/weblog:latest",
      "essential": true,
      "portMappings": [
        { "containerPort": 8080, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "SPRING_DATASOURCE_URL", "value": "jdbc:mysql://weblogdb.cdme4kw4ooif.ap-northeast-2.rds.amazonaws.com:3306/weblogDB?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&sslMode=REQUIRED" },
        { "name": "SPRING_DATASOURCE_USERNAME", "value": "weblog_root" }
      ],
      "secrets": [
        { "name": "SPRING_DATASOURCE_PASSWORD", "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:488762301655:secret:weblog-db-password-CTEntE" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/weblog",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
